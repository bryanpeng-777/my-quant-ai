{
  // total_investment：按市场「生意总投资」（配置键名不变）；current_total_assets：名下「配置总资产」（同币种）。
  // 投资占比：分子=同市场生意总投资−同市场母亲持仓成本，分母=配置总资产−母亲总资产（分母仍跨币种折算）。
  "total_investment": {
    "US": 50000.00,
    "HK": 0
  },
  "current_total_assets": {
    "US": 120000.00,
    "HK": 0
  },
  "records": [
    // 美股示例：股票代码为字母组合（如 AAPL, GOOGL, TSLA）
    // VOO 等指数 ETF：仅需 symbol / purchase_price / quantity，无需 earnings_vwap、eps_growth、博格相关字段
    // 同一只股票可以有多次买入，每次买入独立计算止损
    //
    // 财报字段：写入 earnings_history（按时间追加，旧→新）。新季度来时在数组末尾多加一条，保留旧数据便于对比。
    // bogle_buying_desire_*：百分数点位（如 27.83=27.83%）。最新一期每日流水线重算写回；历史期冻结不再改。
    // 仍兼容旧扁平字段（无 earnings_history 时自动视为单期）。
    {
      "symbol": "AAPL",
      "purchase_price": 150.50,
      "quantity": 100,
      "earnings_history": [
        {
          "earnings_update_date": "2026-01-30",
          "earnings_vwap": 220,
          "dividend_yield": 0.5,
          "eps_growth_GAAP": 8.0,
          "eps_growth_Non_GAAP": 10.0,
          "bogle_buying_desire_GAAP": 12.5,
          "bogle_buying_desire_Non_GAAP": 14.5
        },
        {
          // 下一季财报：横向追加一条即可；上一季博格值已冻结
          "earnings_update_date": "2026-05-01",
          "earnings_vwap": 235,
          "dividend_yield": 0.48,
          "eps_growth_GAAP": 6.5,
          "eps_growth_Non_GAAP": 9.2
          // 最新一期博格可由流水线每日写入
        }
      ]
    },
    // 同一只股票的另一次买入（价格不同，止损点也不同）
    {
      "symbol": "AAPL",
      "purchase_price": 145.00,
      "quantity": 50,
      "earnings_history": [
        {
          "earnings_update_date": "",
          "earnings_vwap": 0,
          "dividend_yield": 0,
          "eps_growth_GAAP": 0,
          "eps_growth_Non_GAAP": 0
        }
      ]
    },
    // 港股示例：股票代码为4位纯数字（如 0700, 9988, 3690）
    {
      "symbol": "0700",
      "purchase_price": 350.00,
      "quantity": 200,
      "earnings_history": [
        {
          "earnings_update_date": "2026-08-12",
          "earnings_vwap": 452,
          "dividend_yield": 1.1,
          "eps_growth_GAAP": 0.17,
          "eps_growth_Non_GAAP": 2.61
        }
      ]
    }
  ]
}
