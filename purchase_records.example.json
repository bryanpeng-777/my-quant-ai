{
  // total_investment：按市场「生意总投资」（配置键名不变）；current_total_assets：名下「配置总资产」（同币种）。
  // 投资占比分母「当前总资产」：配置总资产(美元/港币) − 母亲总资产(美元+港币按汇率折算为对应币种)。
  "total_investment": {
    "US": 50000.00,
    "HK": 0
  },
  "current_total_assets": {
    "US": 120000.00,
    "HK": 0
  },
  "records": [
    // 美股示例：股票代码为字母组合（如 AAPL, GOOGL, TSLA）
    // 同一只股票可以有多次买入，每次买入独立计算止损
    {
      "symbol": "AAPL",              // 股票代码（美股：字母组合）
      "purchase_price": 150.50,      // 购买价格（美元）
      "quantity": 100,               // 购买数量（可选，用于计算盈亏）
      "earnings_vwap": 0,            // 可选：财报日 VWAP，未填视为 0
      "bogle_enterprise_growth": 0   // 可选：博格企业增长（百分数，如 5 表示 5%），未填视为 0
    },
    // 同一只股票的另一次买入（价格不同，止损点也不同）
    {
      "symbol": "AAPL",
      "purchase_price": 145.00,
      "quantity": 50
    },
    // 港股示例：股票代码为4位纯数字（如 0700, 9988, 3690）
    {
      "symbol": "0700",              // 股票代码（港股：4位数字）
      "purchase_price": 350.00,      // 购买价格（港币）
      "quantity": 200
    }
  ]
}
